{
  "rules": {
    "envfreeFuncsStaticCheck": {
      "SUCCESS": [
        "clearanceOf(uint16,address)",
        "delayVetoSelector()",
        "functionScopeConfigForData(uint16,address,bytes)",
        "multisend()",
        "owner()",
        "selectorForData(bytes)"
      ]
    },
    "revokedSelectorCannotBeDirectForwarded": "FAIL",
    "revokedSelectorCannotBeReturnDataForwarded": "FAIL",
    "revokedSelectorCannotBeSafeForwarded": "FAIL"
  }
}
